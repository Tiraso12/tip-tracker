{
  "name": "tip-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test --host 127.0.0.1",
    "dev:local": "firebase emulators:exec --project demo-tip-tracker-test --only auth,firestore \"node scripts/seed-emulators.mjs && vite --mode test --host 127.0.0.1\"",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --project demo-tip-tracker-test --only firestore \"npm run test:rules:run\"",
    "test:rules:run": "node --test tests/rules/**/*.test.js",
    "test:e2e": "firebase emulators:exec --project demo-tip-tracker-test --only auth,firestore \"playwright test\"",
    "test:all": "npm test && npm run test:rules && npm run test:e2e && npm run lint && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-tools": "^15.19.0",
    "globals": "^16.4.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.1.7"
  }
}
