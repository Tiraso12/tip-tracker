rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users collection
    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      // Enforce safe defaults on self-registration — prevents SDK-level role elevation.
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.role == "unassigned" &&
        request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    // Minimal public username lookup. This avoids exposing full user profiles
    // while still allowing username-based login before authentication.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Shifts (admin creates, employees read their own payouts)
    match /shifts/{shiftId} {
      allow read, write: if isAdmin();
    }

    // Per-user tip data — employees read-only; only admins write.
    match /users/{userId}/tips/{document=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Unregistered (temporary) staff — admin-only, explicit rule prevents silent catch-all dependence.
    match /unregisteredStaff/{document=**} {
      allow read, write: if isAdmin();
    }

    // Fallback: admins can access anything else
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
