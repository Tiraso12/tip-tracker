rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users collection
    match /users/{uid} {
      // Users can read their own doc; admins can read/write all
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Shifts (admin creates, employees read their own payouts)
    match /shifts/{shiftId} {
      allow read, write: if isAdmin();
    }

    // Per-user tip data (existing structure: users/{uid}/tips/{dateKey})
    match /tips/{userId}/{document=**} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
    }

    // Fallback: admins can access anything else
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}