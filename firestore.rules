rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: specific user document
    match /users/{userId} {
      // Allow users to read/write their own user profile document
      allow read, write: if isOwner(userId);

      // Recursive match for any subcollections (like 'tips')
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
     match /{document=**} {
      allow read, write: if false;
    }
  }
}
